#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "piper_description"
    doc = """Generated from Composed Stage of root layer /tmp/tmp3ey0ydz7/piper_description.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_piper_description_ri6gt3mq/usdex_piper_description/piper_description.usdc


