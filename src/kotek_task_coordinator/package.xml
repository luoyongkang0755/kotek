<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kotek_task_coordinator</name>
  <version>0.1.0</version>
  <description>
    Top-level state machine sequencing the Scout Mini base controller and
    the Piper manipulator: IDLE -&gt; FIND_SENSOR -&gt; ... -&gt; DONE (plan
    section 10). Enforces that the arm only begins its grasp once the base
    has driven, aligned, and come to a confirmed stop.
  </description>
  <maintainer email="dev@example.com">kotek</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>kotek_msgs</depend>
  <depend>kotek_manipulation</depend>
  <depend>kotek_base_control</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
