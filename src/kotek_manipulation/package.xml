<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kotek_manipulation</name>
  <version>0.1.0</version>
  <description>
    Piper arm grasp sequencing via MoveIt 2 (GraspObject action), plus the
    shared pure-geometry helpers for base standoff and arm-frame
    approach/grasp/lift poses used by both this package and
    kotek_task_coordinator.
  </description>
  <maintainer email="dev@example.com">kotek</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>control_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>kotek_msgs</depend>
  <depend>kotek_base_control</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
